# Bring-up debugging for jasmine_sprout (device tree: JASMINE_DEBUG_BOOT=true).
# Not for releases.

# Bigger kernel log buffer (2 MiB), same as the ramoops console size
CONFIG_LOG_BUF_SHIFT=21

# Report hangs and lockups in the log (and so in pstore)
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_SCHED_STACK_END_CHECK=y

# Allow androidboot.selinux=permissive
CONFIG_SECURITY_SELINUX_DEVELOP=y
