# Init
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# Haptics: stock QTI driver for the QTI vibrator AIDL HAL
CONFIG_INPUT_QTI_HAPTICS=y
# CONFIG_QPNP_HAPTIC is not set

# Camera: camera_v2-oss for the in-tree QCamera2 HAL
CONFIG_MSMB_CAMERA_OSS=y

# WiFi: built in, the device tree does not load wlan.ko
CONFIG_QCA_CLD_WLAN=y

# Optimize for performance (-O2) together with ThinLTO
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
